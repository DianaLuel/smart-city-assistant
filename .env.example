# Smart City Assistant - Environment Configuration

# OpenAI API (optional - uncomment if using OpenAI instead of HuggingFace)
# OPENAI_API_KEY=your-openai-api-key-here

# HuggingFace API (optional - for using HuggingFace Hub models)
# HUGGINGFACEHUB_API_TOKEN=your-huggingface-api-token-here

# Application Settings
DATA_PATH=./data
USE_OPENAI=false

# Server Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Debug Settings
DEBUG=false
